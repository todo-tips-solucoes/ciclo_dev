# Gerado pelo cockpit. Abre uma issue de auditoria (uma por merge) quando um PR é mergeado com check vermelho.
# pull_request_target roda o arquivo da branch base e aqui não baixa nem executa nada do PR.
# Modo autônomo ligado: o check aprovacao-de-dono não conta como vermelho, porque a aprovação de dono deixa de ser exigida
# nas PRs de frente. A linha `Merge autônomo:` da constituição é lida pela API em dois lugares, no commit base do PR (`base.sha`
# do evento) e na ponta da branch de integração (a fonte da verdade do D1), e o filtro só vale com `ligado` nos dois. SHA vazio,
# leitura que falha ou modos diferentes (o modo foi trocado entre a abertura e o merge) abrem a issue, como no modo desligado.
# Qualquer outro check vermelho continua abrindo a issue.
name: audit-merge-vermelho

on:
  pull_request_target:
    types: [closed]

permissions:
  checks: read
  statuses: read
  issues: write
  pull-requests: read

jobs:
  auditar:
    name: auditar
    if: github.event.pull_request.merged == true
    runs-on: ubuntu-latest
    steps:
      - name: Registrar merge com check vermelho
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR: ${{ github.event.pull_request.number }}
          SHA: ${{ github.event.pull_request.head.sha }}
          BASE: ${{ github.event.pull_request.base.ref }}
          URL_PR: ${{ github.event.pull_request.html_url }}
          AUTOR_MERGE: ${{ github.event.pull_request.merged_by.login }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          INTEGRACAO: |-
            {{BRANCH_INTEGRACAO}}
        run: |
          set -euo pipefail
          export LC_ALL=C
          TITULO="Auditoria: PR #$PR mergeado com check vermelho"
          export TITULO
          codificar() {
            local LC_ALL=C s="$1" i c
            for ((i = 0; i < ${#s}; i++)); do
              c="${s:i:1}"
              case "$c" in
                [A-Za-z0-9.~_-]) printf '%s' "$c" ;;
                *) printf '%%%02X' "'$c" ;;
              esac
            done
          }
          vermelhos="$(mktemp)"
          gh api "repos/$REPO/commits/$SHA/check-runs?per_page=100" --paginate \
            --jq '.check_runs[] | select(.conclusion == "failure" or .conclusion == "timed_out" or .conclusion == "cancelled" or .conclusion == "action_required") | .name' >"$vermelhos"
          gh api "repos/$REPO/commits/$SHA/status" \
            --jq '.statuses[] | select(.state == "failure" or .state == "error") | .context' >>"$vermelhos"
          obrigatorios="$(mktemp)"
          gh api "repos/$REPO/rules/branches/$(codificar "$BASE")" \
            --jq '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context' >"$obrigatorios" 2>/dev/null || : >"$obrigatorios"
          nota="Sem regra de checks obrigatórios legível na branch base: todo check vermelho foi listado."
          if [ -s "$obrigatorios" ]; then
            filtrados="$(mktemp)"
            grep -Fxf "$obrigatorios" "$vermelhos" >"$filtrados" || true
            mv "$filtrados" "$vermelhos"
            nota="Lista filtrada pelos checks obrigatórios da branch base."
          fi
          ligado_em() { # ligado_em REF — 0 só com a constituição daquele ref legível e na regra "1 e 1" com ligado, lida sem o `\r` (CRLF)
            local m
            m="$(mktemp)"
            [ -n "$1" ] || return 1 # ref vazio pode ler a branch padrão (o padrão do `ref` na API de conteúdo): vale desligado
            gh api -H "Accept: application/vnd.github.raw+json" "repos/$REPO/contents/docs/constitution.md?ref=$(jq -rn --arg r "$1" '$r | @uri')" 2>/dev/null | tr -d '\r' >"$m" || return 1
            [ "$(grep -cFx 'Merge autônomo: ligado' "$m" || true)" = 1 ] && [ "$(grep -cE '^Merge autônomo: (ligado|desligado)$' "$m" || true)" = 1 ]
          }
          if ligado_em "${BASE_SHA:-}" && ligado_em "$INTEGRACAO"; then
            filtrados="$(mktemp)"
            grep -vFx 'aprovacao-de-dono' "$vermelhos" >"$filtrados" || true
            mv "$filtrados" "$vermelhos"
          fi
          if [ ! -s "$vermelhos" ]; then
            echo "Nenhum check vermelho obrigatório: nada a auditar."
            exit 0
          fi
          corpo="$(mktemp)"
          {
            printf 'PR: %s\nMerge feito por: @%s\n\nChecks vermelhos:\n\n' "$URL_PR" "$AUTOR_MERGE"
            sort -u "$vermelhos" | sed 's/^/- /'
            printf '\n%s\n' "$nota"
          } >"$corpo"
          # ponytail: a listagem direta varre todas as páginas de issues e PRs a cada merge vermelho (teto: cresce com o total); se o volume pesar, filtrar por `since` ou `creator` (Decision 3 da research de audit-merge-vermelho), o que exige nova decisão do owner porque muda a regra de D2 daquela frente.
          ja="$(gh api "repos/$REPO/issues?state=all&per_page=100" --paginate \
            --jq '.[] | select((has("pull_request") | not) and .title == env.TITULO) | .number')"
          if [ -n "$ja" ]; then
            echo "Já existe issue de auditoria para o PR #$PR."
            exit 0
          fi
          gh issue create --repo "$REPO" --title "$TITULO" --body-file "$corpo"
