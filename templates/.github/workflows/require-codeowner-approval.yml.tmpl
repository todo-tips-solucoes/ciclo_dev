# Gerado pelo cockpit. Verificação EXTRA de aprovação de dono, para visibilidade no PR.
# ATENÇÃO: este check é forjável por conteúdo do PR (o fluxo que roda é o do merge commit do
# próprio PR). A garantia real é a regra nativa da branch: aprovações obrigatórias +
# "Require review from Code Owners", com a opção abaixo para descartar aprovações antigas:
# "Dismiss stale pull request approvals when new commits are pushed". Essa opção nativa descarta a
# aprovação só quando entra commit que altera o diff do PR; o check deste fluxo é mais estrito nesse ponto.
# Modo autônomo ligado (linha `Merge autônomo:` da constituição na integração): a aprovação de dono deixa de ser exigida nas PRs de frente;
# sem aprovação o job passa com aviso (a trava caminhos-previstos exige a aprovação onde ela vale). A linha é lida pela API, nunca da árvore do PR.
# Aqui só conta aprovação de dono dada no commit atual do PR; o último estado vale por dono: um pedido de mudança posterior anula só a aprovação do mesmo dono, e a aprovação de outro dono no commit atual continua contando. Este fluxo nunca aprova nem mergeia nada.
name: require-codeowner-approval

on:
  pull_request:
    types: [opened, synchronize, reopened]
  pull_request_review:
    types: [submitted, edited, dismissed]

permissions:
  contents: read
  pull-requests: read

jobs:
  aprovacao-de-dono:
    name: aprovacao-de-dono
    runs-on: ubuntu-latest
    steps:
      - name: Conferir aprovação de dono
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR: ${{ github.event.pull_request.number }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          INTEGRACAO: |-
            {{BRANCH_INTEGRACAO}}
        run: |
          set -euo pipefail
          export LC_ALL=C
          arquivo="$(mktemp)"
          if ! gh api -H "Accept: application/vnd.github.raw+json" \
            "repos/$REPO/contents/.github/CODEOWNERS?ref=$BASE_SHA" >"$arquivo" 2>/dev/null; then
            echo "::error::Não há .github/CODEOWNERS na branch base; crie o arquivo (rode o configurador do cockpit)."
            exit 1
          fi
          donos="$(mktemp)"
          awk '$1 == "*" { for (i = 2; i <= NF; i++) if ($i ~ /^@/) print tolower(substr($i, 2)) }' "$arquivo" >"$donos"
          if [ ! -s "$donos" ]; then
            echo "::error::A linha '*' do .github/CODEOWNERS não lista nenhum dono (@usuario)."
            exit 1
          fi
          head="$(gh api "repos/$REPO/pulls/$PR" --jq .head.sha)" || head=""
          if [ -z "$head" ]; then
            echo "::error::Não consegui ler o commit atual do PR; rode o fluxo de novo."
            exit 1
          fi
          aprovados="$(mktemp)"
          gh api --paginate "repos/$REPO/pulls/$PR/reviews" \
            --jq '.[] | select((.state | ascii_downcase) != "commented" and (.state | ascii_downcase) != "pending") | [.user.login, .state, (.commit_id // "")] | @tsv' \
            | awk -F'\t' -v head="$head" '{ e[tolower($1)] = tolower($2); c[tolower($1)] = $3 } END { for (k in e) if (e[k] == "approved" && c[k] == head) print k }' >"$aprovados"
          if grep -Fxqf "$donos" "$aprovados"; then
            echo "Aprovado por um dono."
            exit 0
          fi
          lista="$(sed 's/^/@/' "$donos" | paste -sd' ' -)"
          modo="$(mktemp)"
          # o `\r` sai antes da regra "1 e 1" (constituição commitada com CRLF)
          gh api -H "Accept: application/vnd.github.raw+json" "repos/$REPO/contents/docs/constitution.md?ref=$(jq -rn --arg r "$INTEGRACAO" '$r | @uri')" 2>/dev/null | tr -d '\r' >"$modo" || : >"$modo"
          if [ "$(grep -cFx 'Merge autônomo: ligado' "$modo" || true)" = 1 ] && [ "$(grep -cE '^Merge autônomo: (ligado|desligado)$' "$modo" || true)" = 1 ]; then
            echo "::warning::Modo autônomo ligado: sem aprovação de dono neste PR. Podem aprovar: $lista"
            echo "Modo autônomo ligado: aprovação de dono não exigida aqui (a trava caminhos-previstos decide)." >>"${GITHUB_STEP_SUMMARY:-/dev/null}"
            exit 0
          fi
          echo "::error::Aprovação pendente. Podem aprovar: $lista"
          exit 1
